<!DOCTYPE html>
<html>
<head><title>آلة جمع</title></head>
<body>
<h2>أول مشروع لي - يجمع رقمين</h2>
<input id="n1" type="number" placeholder="الرقم الأول">
<input id="n2" type="number" placeholder="الرقم الثاني">
<button onclick="s()">اجمع</button>
<p id="result"></p>
<script>
function s(){
let a = parseFloat(document.getElementById('n1').value);
let b = parseFloat(document.getElementById('n2').value);
document.getElementById('result').innerText = "النتيجة = " + (a+b);
}
</script>
</body>
</html>